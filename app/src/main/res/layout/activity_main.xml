<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#3F4242"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="163dp"
            android:background="@color/displayColor"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/previousCalculationTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="#80FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/resultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/displayText"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#998E8E"
            android:columnCount="4"
            android:padding="16dp"
            android:rowCount="5">
            <!---Row 1-->
            <Button
                android:id="@+id/button_clear"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_clear_background"
                android:elevation="6dp"
                android:text="C"
                android:textSize="40dp" />

            <Button
                android:id="@+id/button_Modulus"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_operator_bachground"
                android:elevation="6dp"
                android:text="%"
                android:textSize="40dp" />

            <Button
                android:id="@+id/button_Divide"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_operator_bachground"
                android:elevation="6dp"
                android:text="÷"
                android:textSize="50dp" />

            <Button
                android:id="@+id/button_Delete"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_operator_bachground"
                android:elevation="6dp"
                android:text="Del"
                android:textSize="15dp" />
            <!---Row 2-->
            <Button
                android:id="@+id/button_7"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="7"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_8"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="8"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_9"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="9"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_multiply"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_operator_bachground"
                android:elevation="6dp"
                android:text="X"
                android:textSize="40dp" />
            <!---Row 3-->
            <Button
                android:id="@+id/button_4"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="4"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_5"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="5"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_6"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="6"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_minus"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_operator_bachground"
                android:elevation="6dp"
                android:text="−"
                android:textSize="50dp" />

            <!---Row 4-->
            <Button
                android:id="@+id/button_1"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="1"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_2"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="2"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_3"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="3"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_add"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_operator_bachground"
                android:elevation="6dp"
                android:text="+"
                android:textSize="50dp" />

            <!---Row 5-->
            <Button
                android:id="@+id/button_00"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="00"
                android:textSize="20dp" />

            <Button
                android:id="@+id/button_0"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="0"
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_point"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_background"
                android:elevation="6dp"
                android:text="."
                android:textSize="35dp" />

            <Button
                android:id="@+id/button_equal"
                style="@style/CalculatorButton"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:background="@drawable/button_equal_background"
                android:elevation="6dp"
                android:text="="
                android:textSize="50dp" />


        </GridLayout>


    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="SAMMY"
        android:textColor="@color/white"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="@+id/cardView2"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="@+id/cardView2"
        tools:layout_editor_absoluteY="179dp" />


</androidx.constraintlayout.widget.ConstraintLayout>






