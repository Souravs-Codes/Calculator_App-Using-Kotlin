<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/displayColor"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/previousCalculationTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="#80FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/resultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:maxLines="1"
                android:text="0"
                android:textColor="@color/displayText"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cardView" >

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="4"
            android:padding="16dp"
            android:rowCount="5"
            >
            <!---Row 1-->
            <Button android:id="@+id/button_clear"
                style="@style/CalculatorButton"
                android:elevation="6dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="C"
                android:background="@drawable/button_clear_background"/>

            <Button android:id="@+id/button_Modulus"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="%"
                android:background="@drawable/button_operator_bachground"/>
            <Button android:id="@+id/button_Divide"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="÷"
                android:background="@drawable/button_operator_bachground"/>
            <Button android:id="@+id/button_Delete"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="<--"
                android:background="@drawable/button_operator_bachground"/>
            <!---Row 2-->
            <Button android:id="@+id/button_7"
                style="@style/CalculatorButton"
                android:elevation="6dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="7"
                android:background="@drawable/button_background"/>

            <Button android:id="@+id/button_8"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="8"
                android:background="@drawable/button_background"/>
            <Button android:id="@+id/button_9"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="9"
                android:background="@drawable/button_background"/>
            <Button android:id="@+id/button_multiply"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="X"
                android:background="@drawable/button_operator_bachground"/>
            <!---Row 3-->
            <Button android:id="@+id/button_4"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="4"
                android:background="@drawable/button_background"/>

            <Button android:id="@+id/button_5"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:elevation="6dp"
                android:text="5"
                android:background="@drawable/button_background"/>
            <Button android:id="@+id/button_6"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="6"
                android:background="@drawable/button_background"/>
            <Button android:id="@+id/button_minus"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="-"
                android:background="@drawable/button_operator_bachground"/>

            <!---Row 4-->
            <Button android:id="@+id/button_1"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="1"
                android:background="@drawable/button_background"/>

            <Button android:id="@+id/button_2"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:elevation="6dp"
                android:layout_rowWeight="1"
                android:text="2"
                android:background="@drawable/button_background"/>
            <Button android:id="@+id/button_3"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:elevation="6dp"
                android:text="3"
                android:background="@drawable/button_background"/>
            <Button android:id="@+id/button_add"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:elevation="6dp"
                android:text="+"
                android:background="@drawable/button_operator_bachground"/>

            <!---Row 5-->
            <Button android:id="@+id/button_00"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:text="00"
                android:elevation="6dp"
                android:background="@drawable/button_background"/>

            <Button android:id="@+id/button_0"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:elevation="6dp"
                android:text="0"
                android:background="@drawable/button_background"/>
            <Button android:id="@+id/button_point"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:elevation="6dp"
                android:text="."
                android:background="@drawable/button_background"/>
            <Button android:id="@+id/button_equal"
                style="@style/CalculatorButton"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:elevation="6dp"
                android:text="="
                android:background="@drawable/button_equal_background"/>


</GridLayout>


    </androidx.cardview.widget.CardView>





</androidx.constraintlayout.widget.ConstraintLayout>






